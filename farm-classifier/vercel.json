{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/classify/health",
      "dest": "app.py"
    },
    {
      "src": "/classify/predict",
      "dest": "app.py"
    },
    {
      "src": "/classify/predict-base64",
      "dest": "app.py"
    },
    {
      "src": "/classify/classes",
      "dest": "app.py"
    },
    {
      "src": "/",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}