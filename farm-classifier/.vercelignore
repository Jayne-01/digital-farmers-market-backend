{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/classify/health",
      "dest": "app.py"
    },
    {
      "src": "/classify/predict",
      "dest": "app.py"
    },
    {
      "src": "/classify/predict-base64",
      "dest": "app.py"
    },
    {
      "src": "/classify/classes",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "excludeFiles": "{data/**,__pycache__/**,**/*.pyc,**/*.h5,**/*.keras,test_*.py,*_test.py,*.md,training_history.png,split_stats.json}"
    }
  }
}